# Copy this file to .env.local and fill in values from your Supabase project.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Set this to the official student email domain only after confirming it with your college.
# Example format: nitp.ac.in (example only; verify before using)
VITE_COLLEGE_EMAIL_DOMAIN=
